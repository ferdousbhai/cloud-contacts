# The offers over the contacts. Turn On… looks at both accounts first, then says what mirroring would do; Cancel
# leaves it off.
{"do":"wait","role":"button","name":"Turn On…","visible":true}
{"do":"click","role":"button","name":"Turn On…"}
{"do":"wait","dialog":"Mirror Contacts Between iCloud and Google"}
{"do":"wait","role":"label","name":"These may be one person. Neither is copied until you decide:","visible":true}
{"do":"shot","path":"mirror-review.png"}
{"do":"click","role":"button","name":"Cancel"}
{"do":"wait","dialog":null}
{"do":"wait","role":"switch","name":"Mirror contacts between iCloud and Google","checked":false}

# Not Now puts the offer away.
{"do":"click","role":"button","name":"Not Now"}
{"do":"wait","role":"button","name":"Turn On…","visible":false}

# Review… opens the duplicates: the two Gus Grant cards in Google are likely the same, and Ann Lee is in both
# accounts. Close, and nothing changed.
{"do":"click","role":"button","name":"Review…"}
{"do":"wait","dialog":"Duplicates"}
{"do":"wait","role":"label","name":"Likely the Same","visible":true}
{"do":"wait","role":"label","name":"In Both Accounts","visible":true}
{"do":"shot","path":"mirror-duplicates.png"}
{"do":"click","role":"button","name":"Close"}
{"do":"wait","dialog":null}

# The main menu's Duplicates…, by the keyboard: the menu opens on Refresh, and Down and Enter choose it. Merge All
# leaves one Gus Grant (two rows of one name would be an error here), and the offer to review goes.
{"do":"click","role":"button","name":"Main Menu"}
{"do":"wait","focus":{"role":"menu-item","name":"Refresh"}}
{"do":"key","keys":"Down"}
{"do":"key","keys":"Return"}
{"do":"wait","dialog":"Duplicates"}
{"do":"click","role":"button","name":"Merge All"}
{"do":"wait","dialog":null}
{"do":"wait","role":"label","name":"2 contacts look like duplicates of each other.","visible":false}
{"do":"wait","role":"list-item","name":"Gus Grant, Google","visible":true}
{"do":"shot","path":"mirror-merged.png"}

# The switch below the contacts turns mirroring on through the same review, where the two Ann Lees are called one
# person in their row's drop-down. Each account then has the other's contacts, a company as a company, and one Ann
# Lee. Off again leaves them so.
{"do":"set","role":"switch","name":"Mirror contacts between iCloud and Google","checked":true}
{"do":"wait","dialog":"Mirror Contacts Between iCloud and Google"}
{"do":"wait","toasts":["Looking at both accounts…"]}
{"do":"click","role":"combo-box","name":"Ann Lee (iCloud) · Ann Lee (Google)"}
{"do":"wait","focus":{"role":"list-item","name":"Decide Later"}}
{"do":"key","keys":"Down"}
{"do":"key","keys":"Return"}
{"do":"wait","focus":{"role":"combo-box","name":"Ann Lee (iCloud) · Ann Lee (Google)"}}
{"do":"shot","path":"mirror-same.png"}
{"do":"click","role":"button","name":"Turn On"}
{"do":"wait","dialog":null}
{"do":"wait","role":"list-item","name":"Acme Hardware, Google","visible":true}
{"do":"wait","role":"list-item","name":"Bob Berg, Google","visible":true}
{"do":"wait","role":"list-item","name":"Ann Lee, Acme · Google","visible":true}
{"do":"wait","role":"list-item","name":"Ann Lee, Google Ann Co · Google","visible":false}
{"do":"wait","role":"switch","name":"Mirror contacts between iCloud and Google","checked":true}
{"do":"shot","path":"mirror-on.png"}
{"do":"set","role":"switch","name":"Mirror contacts between iCloud and Google","checked":false}
{"do":"wait","toasts":["Turned off: both accounts keep their contacts as they are"]}
{"do":"wait","role":"switch","name":"Mirror contacts between iCloud and Google","checked":false}
{"do":"quit"}
