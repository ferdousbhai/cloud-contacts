{"do":"key","keys":"Down"}
{"do":"key","keys":"Return"}
{"do":"wait","focus":{"role":"combo-box","name":"Account"}}
{"do":"type","role":"text-box","name":"First name","text":"Grace"}
{"do":"type","role":"text-box","name":"Last name","text":"Hopper"}
{"do":"click","role":"button","name":"Save"}
{"do":"wait","dialog":null}
