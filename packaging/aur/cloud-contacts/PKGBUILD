# Maintainer: Ferdous Bhai <23114244+ferdousbhai@users.noreply.github.com>
pkgname=cloud-contacts
pkgver=0.5.1
pkgrel=1
pkgdesc="Your iCloud and Google contacts side by side on Omarchy (CLI + GTK app)"
arch=('x86_64' 'aarch64')
url="https://github.com/ferdousbhai/cloud-contacts"
license=('MIT')
depends=('gtk4' 'glib2' 'gcc-libs' 'glibc')
makedepends=('cargo' 'git')
checkdepends=('python')  # the tests' stand-in for gws
options=('!debug' '!lto')  # makepkg's C LTO breaks ring's assembly objects
optdepends=(
  'icloud-session: iCloud contacts, through the iCloud sign-in your other iCloud apps share'
  'npm: Google'\''s Workspace CLI (gws) for a Google account'
)
# iCloud for Omarchy's Contacts app (0.11 to 0.12): its window and command
# are this package's iCloud account now.
replaces=('icloud-contacts')
conflicts=('icloud-contacts')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')  # bin/build-package pins the committed source archive's checksum

_srcdir() { echo "$srcdir/cloud-contacts-$pkgver"; }

prepare() {
  cd "$(_srcdir)"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$(_srcdir)"
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-target}"
  cargo build --frozen --release -p cloud-contacts
}

check() {
  cd "$(_srcdir)"
  export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-target}"
  cargo test --frozen --workspace
}

package() {
  cd "$(_srcdir)"
  local data=crates/cloud-contacts/data
  install -Dm755 "${CARGO_TARGET_DIR:-target}/release/cloud-contacts" "$pkgdir/usr/bin/cloud-contacts"
  # The window, off PATH: `cloud-contacts open` runs it. One name for the command, the desktop entry, the icon and
  # the window's class.
  install -Dm755 "${CARGO_TARGET_DIR:-target}/release/cloud-contacts-app" "$pkgdir/usr/lib/cloud-contacts/cloud-contacts-app"
  # The window's command before 0.4.4, on PATH still for key bindings and notification actions: it runs
  # `cloud-contacts open`.
  install -Dm755 packaging/cloud-contacts-app "$pkgdir/usr/bin/cloud-contacts-app"
  install -Dm644 "$data/cloud-contacts.desktop" "$pkgdir/usr/share/applications/cloud-contacts.desktop"
  install -Dm644 "$data/cloud-contacts.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/cloud-contacts.svg"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/user" \
    packaging/systemd/cloud-contacts-mirror.service packaging/systemd/cloud-contacts-mirror.timer
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" NOTICE THIRD_PARTY_NOTICES.md
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
