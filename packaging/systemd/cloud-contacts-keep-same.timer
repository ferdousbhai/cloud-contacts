[Unit]
Description=Keep iCloud and Google contacts the same, every few minutes
Documentation=https://github.com/ferdousbhai/cloud-contacts#keeping-icloud-and-google-the-same

# Enabled by `cloud-contacts keep-same on` (and the window's switch), disabled by off.
[Timer]
OnStartupSec=2min
OnUnitInactiveSec=5min
Persistent=false

[Install]
WantedBy=timers.target
