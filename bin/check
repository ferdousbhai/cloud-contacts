#!/bin/bash
# Every check a change must pass, run on this machine. .githooks/pre-push runs it before a push
# (NO_CHECK=1 skips it); enable the hook once per clone with `git config core.hooksPath .githooks`.
# `bin/check --deep` also runs the random-exploration suites (#[ignore = "deep: ..."]).
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="$HOME/.cargo/bin:$PATH"
# Tests run the built binary with their own HOME and XDG directories; none
# may reach this machine's config.
unset XDG_CONFIG_HOME

step() { printf '\n==> %s\n' "$*"; }

# Vendored support (agent_skill.rs) against its canonical copy in
# icloud-for-omarchy and the other copies beside it.
step "shared support"
python3 bin/check-shared-support

# The desktop app needs GTK 4, and a run that left it out without being asked to would pass having checked half:
# without GTK 4 this fails. NO_APP=1 checks the command line and the library alone, on a machine that has no GTK.
features=()
if [[ ${NO_APP:-} == 1 ]]; then
  echo "note: NO_APP=1: cloud-contacts-app and its window QA are not checked" >&2
  features=(--no-default-features)
elif ! pkg-config --exists gtk4 2>/dev/null; then
  echo "bin/check: GTK 4 is not installed, so the window cannot be checked (install gtk4; NO_APP=1 leaves it out)" >&2
  exit 1
fi

step "rustfmt (fix with: cargo fmt --all)"
cargo fmt --all -- --check
step "clippy"
cargo clippy --locked --workspace "${features[@]}" --all-targets -- -D warnings
step "cargo test"
cargo test --locked --workspace "${features[@]}"
if [[ ${1:-} == --deep ]]; then
  step "deep: random exploration"
  cargo test --locked --workspace "${features[@]}" -- --ignored
fi

if ((${#features[@]} == 0)); then
  # The window driven through its flows on the stand-in accounts, on a private broadway display; any GTK warning
  # fails it. Only this build has omui's QA in it.
  step "app QA (dev/qa)"
  cargo build --locked -p cloud-contacts --features qa --bins --examples
  dev/qa.sh "${CARGO_TARGET_DIR:-target}/debug/cloud-contacts-app" dev/qa/*.jsonl
fi

step "packaging"
bash packaging/repo/test.sh
python3 packaging/repo/test_arch.py
# bash -n reads one script (the rest would be its arguments), so one at a time.
for script in bin/arch-run packaging/aur/cloud-contacts/PKGBUILD packaging/cloud-contacts-app bin/build-package bin/release bin/verify-release \
  .githooks/pre-push dev/preview.sh dev/qa.sh; do
  bash -n "$script"
done

printf '\nAll checks passed.\n'
