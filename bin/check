#!/bin/bash
# Every check a change must pass, run on this machine. .githooks/pre-push runs it before a push
# (NO_CHECK=1 skips it); enable the hook once per clone with `git config core.hooksPath .githooks`.
# `bin/check --deep` also runs the random-exploration suites (#[ignore = "deep: ..."]).
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="$HOME/.cargo/bin:$PATH"
# Tests run the built binary with their own HOME and XDG directories; none
# may reach this machine's config.
unset XDG_CONFIG_HOME

step() { printf '\n==> %s\n' "$*"; }

# Vendored support (agent_skill.rs) against its canonical copy in
# icloud-for-omarchy and the other copies beside it.
step "shared support"
python3 bin/check-shared-support

# The desktop app needs GTK 4; without it only the CLI and the library are checked.
features=()
if ! pkg-config --exists gtk4 2>/dev/null; then
  echo "note: skipping cloud-contacts-app (install gtk4 to check it)" >&2
  features=(--no-default-features)
fi

step "rustfmt (fix with: cargo fmt --all)"
cargo fmt --all -- --check
step "clippy"
cargo clippy --locked --workspace "${features[@]}" --all-targets -- -D warnings
step "cargo test"
cargo test --locked --workspace "${features[@]}"
if [[ ${1:-} == --deep ]]; then
  step "deep: random exploration"
  cargo test --locked --workspace "${features[@]}" -- --ignored
fi

step "packaging"
bash packaging/repo/test.sh
python3 packaging/repo/test_arch.py
bash -n bin/arch-run packaging/aur/cloud-contacts/PKGBUILD bin/build-package bin/release bin/verify-release .githooks/pre-push

printf '\nAll checks passed.\n'
